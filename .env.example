# LLM 配置
LLM_PROVIDER=mock
# 支持: mock | openai | deepseek | zhipu
# mock 模式无需 API Key，使用内置模板生成逼真数据
# Prompt 实战建议设为 false：DeepSeek 调用失败时直接报错，避免误以为 Mock 输出是真实模型输出
LLM_ENABLE_MOCK_FALLBACK=true

OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek 配置（使用 OpenAI 兼容 SDK）
# 切换 DeepSeek 时：
# LLM_PROVIDER=deepseek
# LLM_ENABLE_MOCK_FALLBACK=false
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阶段 5：简历结构化提取（与旧演示 AI 配置隔离）
# 默认使用当前官方支持 JSON Output 的 DeepSeek V4 Flash；可按部署需要覆盖模型名。
RESUME_STRUCTURE_ENABLED=true
RESUME_STRUCTURE_MODEL=deepseek-v4-flash
RESUME_STRUCTURE_TIMEOUT_SECONDS=90
RESUME_STRUCTURE_PROCESSING_LEASE_SECONDS=180
RESUME_STRUCTURE_MAX_INPUT_CHARS=100000
RESUME_STRUCTURE_MAX_OUTPUT_TOKENS=12000
RESUME_STRUCTURE_PROMPT_VERSION=resume_structure_v1
RESUME_STRUCTURE_SCHEMA_VERSION=1.0

# 阶段 7：岗位评分标准 AI 草稿生成（生成后必须由 HR 发布）
RUBRIC_GENERATION_ENABLED=true
RUBRIC_GENERATION_MODEL=deepseek-v4-flash
RUBRIC_GENERATION_TIMEOUT_SECONDS=90
RUBRIC_GENERATION_MAX_OUTPUT_TOKENS=8000
RUBRIC_GENERATION_PROMPT_VERSION=rubric_generation_v2
RUBRIC_ITEM_ASSIST_PROMPT_VERSION=rubric_item_assist_v1
RUBRIC_SHARE_OPTIMIZATION_PROMPT_VERSION=rubric_share_optimization_v1
RUBRIC_GENERATION_SCHEMA_VERSION=1.0

# Stage 7 candidate semantic evaluation (single DeepSeek JSON request)
SCREENING_MODEL_ENABLED=true
SCREENING_MODEL_NAME=deepseek-v4-flash
SCREENING_MODEL_TIMEOUT_SECONDS=90
SCREENING_MODEL_MAX_INPUT_CHARS=160000
SCREENING_MODEL_MAX_OUTPUT_TOKENS=8000
SCREENING_MODEL_PROMPT_VERSION=screening_evaluation_v3
SCREENING_MODEL_SCHEMA_VERSION=1.0
# Optional cost estimate in the deployment account's billing currency:
# SCREENING_MODEL_INPUT_COST_PER_MILLION=0.00
# SCREENING_MODEL_OUTPUT_COST_PER_MILLION=0.00

# 数据库（新版唯一运行数据库）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment_assistant
POSTGRES_DB=recruitment_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Chroma 向量库
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_RESUMES=resumes

# 服务器
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 云平台通常会自动注入 PORT；本地不需要配置
# PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 线上前端地址，可填写 Vercel 域名，例如 https://your-app.vercel.app
FRONTEND_ORIGIN=

# 前端构建时使用。部署到 Vercel 时在 Vercel 环境变量中配置，不一定读取此文件。
# 示例：https://your-backend.onrender.com
VITE_API_BASE_URL=

# 私有简历存储；原文件只通过受控 API 读取，不挂载公开静态目录
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=10
# 新版未绑定简历清理：后端启动后先等待一个周期，再按周期清理过期记录
RESUME_CLEANUP_ENABLED=true
RESUME_UNBOUND_RETENTION_HOURS=24
RESUME_CLEANUP_INTERVAL_MINUTES=60
RESUME_CLEANUP_BATCH_SIZE=50
