{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "轻量评价清单驱动的 AI 初筛工作流",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-flow",
        "label": "初筛主链",
        "focus": ["job-jd", "generate-plan", "confirm-plan", "prepare-input", "model-evaluate", "validate-output", "persist-report", "hr-decision"],
        "note": "从完整 JD 到结构化报告，再由 HR 独立作出招聘决定。"
      },
      {
        "id": "validation-flow",
        "label": "校验与持久化",
        "focus": ["model-evaluate", "validate-output", "persist-report", "hr-decision"],
        "note": "模型输出先通过确定性校验与事务保护，才能成为 HR 可见的 current 报告。"
      }
    ]
  },
  "lanes": [
    {
      "id": "hr",
      "label": "HR 决策与确认"
    },
    {
      "id": "service",
      "label": "Screening Service"
    },
    {
      "id": "service-storage",
      "label": "Service / DeepSeek / PostgreSQL"
    }
  ],
  "phases": [
    {
      "id": "plan-phase",
      "label": "评价清单",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "evaluation-phase",
      "label": "模型评价与校验",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "decision-phase",
      "label": "持久化与人工决定",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "job-jd",
    "generate-plan",
    "confirm-plan",
    "prepare-input",
    "model-evaluate",
    "validate-output",
    "persist-report",
    "hr-decision"
  ],
  "nodes": [
    {
      "id": "job-jd",
      "lane": "hr",
      "col": 0,
      "type": "frontend",
      "label": "完整五段式 JD",
      "sublabel": "岗位事实",
      "width": 138
    },
    {
      "id": "generate-plan",
      "lane": "service-storage",
      "col": 1,
      "type": "backend",
      "label": "生成轻量评价清单",
      "sublabel": "约 5—12 项",
      "width": 138
    },
    {
      "id": "confirm-plan",
      "lane": "hr",
      "col": 2,
      "type": "security",
      "label": "HR 编辑并确认",
      "sublabel": "确认后只读",
      "tag": "人类门禁",
      "width": 138
    },
    {
      "id": "prepare-input",
      "lane": "service-storage",
      "col": 3,
      "type": "security",
      "label": "检查前置条件并脱敏",
      "sublabel": "JD + 清单 + 当前 Resume",
      "width": 150
    },
    {
      "id": "model-evaluate",
      "lane": "service-storage",
      "col": 4,
      "type": "external",
      "label": "DeepSeek 生成报告",
      "sublabel": "逐项评价 + 总体建议分",
      "width": 145
    },
    {
      "id": "validate-output",
      "lane": "service",
      "col": 4,
      "type": "security",
      "label": "Schema / Service 校验",
      "sublabel": "结构、引用、安全、快照",
      "width": 145
    },
    {
      "id": "persist-report",
      "lane": "service-storage",
      "col": 5,
      "type": "database",
      "label": "事务保存 current 报告",
      "sublabel": "旧报告转历史",
      "width": 145
    },
    {
      "id": "hr-decision",
      "lane": "hr",
      "col": 5,
      "type": "frontend",
      "label": "HR 独立决策",
      "sublabel": "通过 / 备选 / 淘汰",
      "tag": "AI 不越权",
      "width": 138
    }
  ],
  "edges": [
    {
      "id": "jd-to-plan",
      "from": "job-jd",
      "to": "generate-plan",
      "label": "岗位评价输入",
      "role": "main"
    },
    {
      "id": "plan-to-confirm",
      "from": "generate-plan",
      "to": "confirm-plan",
      "label": "待确认草稿",
      "role": "main"
    },
    {
      "id": "confirm-to-input",
      "from": "confirm-plan",
      "to": "prepare-input",
      "label": "Schema 5.0 ready",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "input-to-model",
      "from": "prepare-input",
      "to": "model-evaluate",
      "label": "版本化 Prompt",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "model-to-validation",
      "from": "model-evaluate",
      "to": "validate-output",
      "label": "JSON 输出",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "validation-to-persist",
      "from": "validate-output",
      "to": "persist-report",
      "label": "全量校验通过",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "persist-to-decision",
      "from": "persist-report",
      "to": "hr-decision",
      "label": "结构化报告仅供参考",
      "variant": "emphasis",
      "role": "main"
    }
  ]
}
