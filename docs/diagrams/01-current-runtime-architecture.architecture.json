      "row": 1,
      "col": 4
    },
    {
      "id": "postgresql",
      "type": "database",
      "label": "PostgreSQL 16",
      "sublabel": "正式业务数据与约束",
      "row": 1,
      "col": 5
    },
    {
      "id": "deepseek-adapter",
      "type": "backend",
      "label": "模型 Adapter",
      "sublabel": "OpenAI 兼容调用",
      "row": 0,
      "col": 4
    },
    {
      "id": "deepseek-api",
      "type": "external",
      "label": "DeepSeek API",
      "sublabel": "结构化与语义评价",
      "row": 0,
      "col": 5
    },
    {
      "id": "postgres-workers",
      "type": "backend",
      "label": "后台 Worker",
      "sublabel": "处理与初筛循环",
      "row": 2,
      "col": 3
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "公开投递摘要限流",
      "row": 2,
      "col": 4
    },
    {
      "id": "private-storage",
      "type": "database",
      "label": "私有文件存储",
      "sublabel": "原始简历文件",
      "row": 2,
      "col": 5
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "HR智聘应用运行边界",
      "wraps": [
        "react-app",
        "fastapi-api",
        "pydantic-schema",
        "business-services",
        "postgresql",
        "deepseek-adapter",
        "postgres-workers",
        "redis",
        "private-storage"
      ],
      "pad": 24
    }
  ],
  "connections": [
    {
      "id": "browser-uses-react",
      "from": "users",
      "to": "react-app",
      "label": "浏览器操作",
      "variant": "emphasis"
    },
    {
      "id": "react-calls-api",
      "from": "react-app",
      "to": "fastapi-api",
      "label": "HTTP / JSON / multipart",
      "variant": "emphasis",
      "labelAt": [424, 382]
    },
    {
      "id": "api-validates-schema",
      "from": "fastapi-api",
      "to": "pydantic-schema",
      "label": "请求与响应校验",
      "variant": "security"
    },
    {
      "id": "schema-enters-service",
      "from": "pydantic-schema",
      "to": "business-services",
      "label": "强类型业务输入",
      "variant": "emphasis"
    },
    {
      "id": "service-persists",
      "from": "business-services",
      "to": "postgresql",
      "label": "SQLAlchemy 事务",
      "variant": "emphasis"
    },
    {
      "id": "service-calls-adapter",
      "from": "business-services",
      "to": "deepseek-adapter",
      "label": "版本化 Prompt",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "adapter-calls-model",
      "from": "deepseek-adapter",
      "to": "deepseek-api",
      "label": "HTTPS 模型请求"
    },
    {
      "id": "worker-reuses-service",
      "from": "postgres-workers",
      "to": "business-services",
      "label": "固定步骤编排",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "worker-claims-runs",
      "from": "postgres-workers",
      "to": "postgresql",
      "label": "SKIP LOCKED / 租约",
      "fromSide": "bottom",
      "toSide": "right",
      "via": [[748, 580], [1300, 580], [1300, 338]]
    },
    {
      "id": "service-rate-limits",
      "from": "business-services",
      "to": "redis",
      "label": "限流摘要",
      "fromSide": "bottom",
      "toSide": "top",
      "labelAt": [1012, 410]
    },
    {
      "id": "service-stores-files",
      "from": "business-services",
      "to": "private-storage",
      "label": "私有文件读写"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "两条主线",
      "items": [
        "前端 → API → Schema → Service → Model → PostgreSQL",
        "Prompt → Adapter/模型 → 校验 → 持久化 → HR 决策"
      ]
    },
    {
      "dot": "emerald",
      "title": "可靠性边界",
      "items": [
        "确定性状态、权限、事务和审计由 Service 与 PostgreSQL 负责",
        "模型失败不能删除原简历、投递事实或旧成功结果"
      ]
    },
    {
      "dot": "amber",
      "title": "当前范围",
      "items": [
        "当前已实现招聘主链、公开投递、AI 初筛、面试、Offer 与录取",
        "首页综合 Agent 与 RAG 属于暂缓的长期方向，不在本图中冒充现有能力"
      ]
    }
  ]
}
