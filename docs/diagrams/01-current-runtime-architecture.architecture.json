{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "HR智聘当前运行时架构",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "request-path",
        "label": "同步请求主链",
        "focus": ["users", "react-app", "fastapi-api", "pydantic-schema", "business-services", "postgresql"],
        "note": "从浏览器操作到 PostgreSQL 事务落库，依次观察每一层的职责。"
      },
      {
        "id": "ai-path",
        "label": "AI 调用边界",
        "focus": ["business-services", "deepseek-adapter", "deepseek-api"],
        "note": "Service 通过 Adapter 调用 DeepSeek，模型不直接接触 API 或数据库。"
      },
      {
        "id": "async-path",
        "label": "异步处理路径",
        "focus": ["postgres-workers", "business-services", "postgresql", "private-storage"],
        "note": "Worker 领取 PostgreSQL 持久任务，再复用业务 Service 完成处理。"
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "origin": [40, 150],
    "cols": 6,
    "gapX": 56,
    "gapY": 86,
    "cellW": 160,
    "cellH": 72
  },
  "components": [
    {
      "id": "users",
      "type": "external",
      "label": "候选人 / HR",
      "sublabel": "浏览器用户",
      "row": 1,
      "col": 0
    },
    {
      "id": "react-app",
      "type": "frontend",
      "label": "React 工作台",
      "sublabel": "/apply 与 /app/*",
      "row": 1,
      "col": 1
    },
    {
      "id": "fastapi-api",
      "type": "backend",
      "label": "FastAPI API",
      "sublabel": "/api/v2/*",
      "row": 1,
      "col": 2
    },
    {
      "id": "pydantic-schema",
      "type": "security",
      "label": "Pydantic Schema",
      "sublabel": "输入输出合同",
      "row": 1,
      "col": 3
    },
    {
      "id": "business-services",
      "type": "backend",
      "label": "业务 Service",
