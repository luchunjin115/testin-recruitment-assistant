{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "AI 初筛等待、Repair 与失败保护",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [1080, 616],
    "legend": {"mode": "hidden"},
    "views": [
      {
        "id": "normal-run",
        "label": "正常运行",
        "focus": ["request", "context-check", "queued", "running", "succeeded"],
        "note": "输入满足条件后进入 PostgreSQL 持久队列，由 Worker 领取并完成报告。"
      },
      {
        "id": "wait-and-resume",
        "label": "等待与恢复",
        "focus": ["context-check", "waiting-input", "queued"],
        "note": "Resume 或评价计划未就绪属于可恢复等待，不是终态失败。"
      },
      {
        "id": "repair-and-failure",
        "label": "Repair 与安全失败",
        "focus": ["running", "repair-once", "failed"],
        "note": "白名单输出合同错误最多 Repair 一次；安全错误或重试耗尽进入失败。"
      }
    ]
  },
  "lanes": [
    {"id": "main", "label": "ScreeningRun 主阶段"},
    {"id": "waiting", "label": "业务等待"},
    {"id": "recovery", "label": "受控恢复"},
    {"id": "terminal", "label": "终态"}
  ],
  "states": [
    {"id": "request", "type": "start", "label": "触发初筛", "sublabel": "自动或 HR 重评", "lane": "main", "col": 0, "step": "01", "width": 100},
    {"id": "context-check", "type": "decision", "label": "检查输入快照", "sublabel": "四项输入齐备", "lane": "main", "col": 1, "step": "02", "width": 140},
    {"id": "queued", "type": "active", "label": "queued", "sublabel": "任务已创建", "lane": "main", "col": 2, "step": "03", "width": 100},
    {"id": "running", "type": "active", "label": "running", "sublabel": "Worker 持租约执行", "lane": "main", "col": 3, "step": "04"},
    {"id": "succeeded", "type": "success", "label": "succeeded", "sublabel": "current 报告已提交", "lane": "main", "col": 4, "step": "05"},
    {"id": "waiting-input", "type": "waiting", "label": "waiting_resume / plan", "sublabel": "缺少可用输入", "lane": "waiting", "col": 0, "tag": "非终态"},
    {"id": "repair-once", "type": "failure", "label": "一次受控 Repair", "sublabel": "完整报告重新校验", "lane": "recovery", "col": 1, "tag": "最多一次"},
    {"id": "failed", "type": "failure", "label": "failed", "sublabel": "旧成功报告仍保留", "lane": "terminal", "col": 2, "tag": "安全终态", "yOffset": -40}
  ],
  "transitions": [
    {"id": "request-check", "from": "request", "to": "context-check", "label": "建立输入指纹", "variant": "emphasis", "route": "top-channel", "channelY": 92, "labelAt": [171, 104]},
    {"id": "check-queued", "from": "context-check", "to": "queued", "label": "全部前置条件满足", "variant": "emphasis", "route": "top-channel", "channelY": 68, "labelAt": [325, 80]},
    {"id": "queued-running", "from": "queued", "to": "running", "label": "SKIP LOCKED + 租约", "variant": "emphasis", "labelAt": [479, 202]},
    {"id": "running-success", "from": "running", "to": "succeeded", "label": "复核输入并事务提交", "variant": "emphasis", "labelAt": [700, 214]},
    {"id": "check-wait", "from": "context-check", "to": "waiting-input", "label": "Resume 或计划未就绪", "variant": "dashed"},
    {"id": "wait-resume", "from": "waiting-input", "to": "queued", "label": "条件恢复", "variant": "dashed"},
    {"id": "running-repair", "from": "running", "to": "repair-once", "label": "白名单合同错误", "variant": "dashed", "labelAt": [480, 230]},
    {"id": "repair-running", "from": "repair-once", "to": "running", "label": "重新全量校验", "variant": "emphasis", "labelAt": [680, 255]},
    {"id": "running-failed", "from": "running", "to": "failed", "label": "安全错误或重试耗尽", "variant": "security", "labelAt": [633, 350]}
  ]
}
